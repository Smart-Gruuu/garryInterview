<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-agnostic core: speech-to-text, LLM, transcript and prompt logic.
       Shared by the Windows and Android builds of the MAUI app and unit-tested in isolation. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InterviewAssist.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InterviewAssist.Core.Tests" />
  </ItemGroup>

</Project>
