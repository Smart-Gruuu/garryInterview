<!-- Alert (one button) or confirmation (two buttons), shown over the window by AvaloniaDialogService. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InterviewAssist.Desktop.Views.Dialogs.MessageDialog">

    <Border Classes="Card Dialog">
        <StackPanel Spacing="10">
            <TextBlock x:Name="TitleText"
                       Classes="DialogTitle" />

            <SelectableTextBlock x:Name="MessageText"
                                 TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,6,0,0">
                <Button x:Name="CancelButton"
                        Click="OnCancelClick" />
                <Button x:Name="AcceptButton"
                        Classes="Primary"
                        Click="OnAcceptClick" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
