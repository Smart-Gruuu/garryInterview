<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InterviewAssist.Presentation.ViewModels"
             xmlns:controls="using:InterviewAssist.Desktop.Controls"
             xmlns:conv="using:InterviewAssist.Desktop.Converters"
             x:Class="InterviewAssist.Desktop.Views.LiveView"
             x:DataType="vm:MainViewModel"
             Padding="8">

    <UserControl.Resources>
        <conv:StatusKindToBrushConverter x:Key="StatusBrush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Highlighted chip: Start while idle, 📌 while pinned, 👁 while stealth is on. -->
        <Style Selector="Button.Chip.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.Chip.dangerText /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Arc.Spinner">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StartAngle" Value="0" />
            <Setter Property="SweepAngle" Value="270" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!-- Row 1 (transcript ≈ 35% of the space left for the two cards) is sized in code: it collapses when hidden. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,0.55*,*,Auto">

        <!-- 1. Top bar: status, level, elapsed, quick toggles -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" MinHeight="30">
            <Ellipse Width="10"
                     Height="10"
                     VerticalAlignment="Center"
                     Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       ToolTip.Tip="{Binding StatusText}"
                       FontSize="{DynamicResource SmallFontSize}"
                       MaxLines="2"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <!-- Audio level meter -->
            <ProgressBar Grid.Column="2"
                         Width="30"
                         Height="6"
                         MinWidth="0"
                         MinHeight="0"
                         CornerRadius="3"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding AudioLevel}"
                         Background="{DynamicResource SurfaceAltBrush}"
                         Foreground="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         IsVisible="{Binding IsListening}" />

            <TextBlock Grid.Column="3"
                       Classes="Caption"
                       Text="{Binding ElapsedText}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsListening}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="Chip"
                        Classes.on="{Binding !IsListening}"
                        Content="{Binding ListenButtonText}"
                        Command="{Binding ToggleListeningCommand}"
                        ToolTip.Tip="Start or stop live captions" />

                <Button Classes="Chip"
                        Classes.on="{Binding Settings.AlwaysOnTop}"
                        Content="📌"
                        Command="{Binding TogglePinCommand}"
                        IsVisible="{Binding SupportsPin}"
                        ToolTip.Tip="Keep this window on top"
                        AutomationProperties.Name="Always on top" />

                <Button Classes="Chip"
                        Classes.on="{Binding Settings.StealthMode}"
                        Content="👁"
                        Command="{Binding ToggleStealthCommand}"
                        IsVisible="{Binding SupportsStealth}"
                        ToolTip.Tip="Stealth: hide this window from screen sharing and recordings"
                        AutomationProperties.Name="Stealth mode" />

                <Button Classes="Chip"
                        Content="💬"
                        Command="{Binding ToggleTranscriptCommand}"
                        ToolTip.Tip="Show or hide the transcript"
                        AutomationProperties.Name="Show or hide transcript" />
            </StackPanel>
        </Grid>

        <!-- 2. Transcript -->
        <Border Grid.Row="1"
                Classes="Card"
                Margin="0,6,0,0"
                Padding="10,8"
                IsVisible="{Binding Settings.ShowTranscript}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="SectionTitle" Text="TRANSCRIPT" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="Caption"
                               Text="⏎ Enter to answer"
                               Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasPendingQuestion}" />
                    <Button Grid.Column="2"
                            Classes="Chip"
                            Content="Clear"
                            Command="{Binding ClearTranscriptCommand}"
                            ToolTip.Tip="Clear the transcript" />
                </Grid>

                <!-- The question to send: live captions keep flowing in (even while editing); edit freely, Enter sends it. -->
                <TextBox x:Name="DraftEditor"
                         Grid.Row="1"
                         Text="{Binding QuestionDraft}"
                         PlaceholderText="The interviewer's words appear here as they speak. Delete anything you don't want sent, then press Enter."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="0"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ToolTip.Tip="Edit before sending. Enter sends, Shift+Enter adds a line." />

                <!-- Words still being recognized. Also sent on Enter. -->
                <TextBlock Grid.Row="2"
                           Text="{Binding LiveText}"
                           Foreground="{DynamicResource InterimTextBrush}"
                           FontStyle="Italic"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="3"
                           IsVisible="{Binding LiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
        </Border>

        <!-- 3. Answer -->
        <Border Grid.Row="2"
                Classes="Card"
                Margin="0,6,0,0"
                Padding="12,10,12,8">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasCurrentItem}">
                    <TextBlock Text="{Binding CurrentItem?.Question, TargetNullValue=''}"
                               Foreground="{DynamicResource QuestionTextBrush}"
                               FontWeight="Bold"
                               MaxLines="3"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <Arc Grid.Column="1"
                         Classes="Spinner"
                         VerticalAlignment="Top"
                         IsVisible="{Binding CurrentItem?.IsStreaming, TargetNullValue=False}" />
                </Grid>

                <ScrollViewer x:Name="AnswerScroll"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasCurrentItem}">
                    <StackPanel Spacing="8" Margin="0,0,8,4">
                        <controls:MarkdownTextBlock Markdown="{Binding CurrentItem?.Answer, TargetNullValue=''}"
                                                    TextWrapping="Wrap"
                                                    FontSize="{DynamicResource AnswerFontSize}"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    AccentBrush="{DynamicResource AccentBrush}"
                                                    CodeBackgroundBrush="{DynamicResource CodeBackgroundBrush}"
                                                    CodeTextBrush="{DynamicResource CodeTextBrush}" />
                        <SelectableTextBlock Text="{Binding CurrentItem?.ErrorMessage, TargetNullValue=''}"
                                             Foreground="{DynamicResource DangerBrush}"
                                             TextWrapping="Wrap"
                                             IsVisible="{Binding CurrentItem?.HasError, TargetNullValue=False}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel Grid.RowSpan="2"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !HasCurrentItem}">
                    <TextBlock Text="How it works"
                               FontWeight="Bold"
                               FontSize="{DynamicResource LargeFontSize}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="1.  Setup: paste your resume and the job description." TextWrapping="Wrap" />
                    <TextBlock Text="2.  Settings: add your Deepgram and OpenAI API keys." TextWrapping="Wrap" />
                    <TextBlock Text="3.  Press Start. After each question, trim the text in the box if needed and press Enter."
                               TextWrapping="Wrap" />
                    <TextBlock Classes="Caption"
                               Text="Esc stops an answer. You can also type a question below."
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="4"
                      IsVisible="{Binding HasCurrentItem}">
                    <Button Classes="Chip"
                            Content="◀"
                            Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Previous answer" />
                    <TextBlock Grid.Column="1"
                               Classes="Caption"
                               Text="{Binding PositionText}"
                               MinWidth="36"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Classes="Chip"
                            Content="▶"
                            Command="{Binding NextCommand}"
                            ToolTip.Tip="Next answer" />

                    <Button Grid.Column="4"
                            Classes="Chip dangerText"
                            Content="■ Stop"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsGenerating}"
                            ToolTip.Tip="Stop generating (Esc)" />
                    <Button Grid.Column="5"
                            Classes="Chip"
                            Content="Copy"
                            Command="{Binding CopyAnswerCommand}"
                            ToolTip.Tip="Copy the answer" />
                    <Button Grid.Column="6"
                            Classes="Chip"
                            Content="↻"
                            Command="{Binding RegenerateCommand}"
                            ToolTip.Tip="Regenerate this answer"
                            AutomationProperties.Name="Regenerate" />
                    <Button Grid.Column="7"
                            Classes="Chip"
                            Content="🗑"
                            Command="{Binding ClearAllCommand}"
                            ToolTip.Tip="Clear all answers and the transcript"
                            AutomationProperties.Name="Clear all" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Type a question / Ask -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,6,0,0">
            <TextBox x:Name="TypedQuestionBox"
                     Classes="clearButton"
                     Text="{Binding TypedQuestion}"
                     PlaceholderText="Type a question, or press Enter to answer the last one"
                     VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="Chip"
                    Command="{Binding ChooseInterviewTypeCommand}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Interview type: changes the tone and approach of the answers"
                    AutomationProperties.Name="Interview type">
                <TextBlock Text="{Binding InterviewTypeLabel, StringFormat='{}{0} ▾'}" />
            </Button>
            <Button Grid.Column="2"
                    Classes="Primary"
                    Content="Ask ⏎"
                    Command="{Binding SubmitTypedCommand}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Answer the typed question, or the latest one from the transcript" />
        </Grid>

        <!-- 5. Toast (last child so it draws on top; never takes input) -->
        <Panel Grid.RowSpan="4"
               VerticalAlignment="Bottom"
               HorizontalAlignment="Center"
               Margin="16,0,16,56"
               MaxWidth="380"
               IsHitTestVisible="False"
               IsVisible="{Binding ToastText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Border Background="{DynamicResource TextBrush}" CornerRadius="14" Opacity="0.94" />
            <TextBlock Text="{Binding ToastText}"
                       Margin="14,7"
                       Foreground="{DynamicResource AppBackgroundBrush}"
                       FontSize="{DynamicResource SmallFontSize}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Panel>
    </Grid>
</UserControl>
